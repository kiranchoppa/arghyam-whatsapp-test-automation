JALSHOOCHAK_WHATSAPP_NUMBER=+91XXXXXXXXXX
USER_NUMBER=+91XXXXXXXXXX
APP_ENV=dev
START_MESSAGE=start
WHATSAPP_BROWSER=edge
EDGE_PROFILE_DIR=/home/your-user/path/to/project/.whatsapp_edge_profile
EDGE_PROFILE_NAME=Default
KEEP_BROWSER_OPEN=false
SEND_TIMEOUT_SECONDS=120
RESPONSE_TIMEOUT_SECONDS=60

# PostgreSQL database connection (main — jalsoochak)
DB_URL=postgresql://localhost:5432/your_database
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# PostgreSQL database connection (analytics — used by no_water_supply flow)
ANALYTICS_DB_URL=postgresql://localhost:5432/analytics
ANALYTICS_DB_USERNAME=your_analytics_db_user
ANALYTICS_DB_PASSWORD=your_analytics_db_password

# Anomaly table filter values (no_water_supply flow DB verification)
ANOMALY_USER_ID=21350
ANOMALY_SCHEME_ID=27653

# Glific config
TENT_ID=17
IS_SINGLE_TENANT=false
